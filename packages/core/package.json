{
  "name": "@kulala/core",
  "version": "0.0.0",
  "private": false,
  "homepage": "https://github.com/dont-be-evil-company/kulala-core#readme",
  "bugs": {
    "url": "https://github.com/dont-be-evil-company/kulala-core/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dont-be-evil-company/kulala-core.git"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "bun test",
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --outdir dist --format esm --target bun --sourcemap --define __KULALA_EMBED_CURL__=false --define __KULALA_EMBED_JQ__=false",
    "build:types": "tsc -p tsconfig.build.json",
    "prepack": "cp ./../../README.md . && cp ./../../LICENSE . && bun run build"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
